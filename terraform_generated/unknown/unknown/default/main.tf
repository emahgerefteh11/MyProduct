# AWS Infrastructure Stack generated by Cloud Cost Atlas IaC Vending Engine
terraform {
  required_version = ">= 1.0.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
  default_tags {
    tags = local.common_tags
  }
}

locals {
  common_tags = merge(var.custom_tags, {
    Platform    = "unknown"
    Product     = "unknown"
    Environment = "default"
    ManagedBy   = "Terraform-CloudCostAtlas"
  })
}

# Discovered Compute/VM Instance (Discovered SKU: c5.xlarge)
resource "aws_instance" "unknown_app" {
  ami           = var.ami_id != "" ? var.ami_id : "ami-0c55b159cbfafe1f0" # Amazon Linux 2 (us-east-1)
  instance_type = var.instance_type

  root_block_device {
    volume_size           = var.root_volume_size_gb
    volume_type           = "gp3"
    encrypted             = true
    delete_on_termination = true
  }

  tags = {
    Name = "unknown-default-app"
  }
}
